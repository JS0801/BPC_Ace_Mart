            <formula></formula>
            <type>VISUAL_BUILDER</type>
          </initcondition>
          <parametersettings>
            <parametersetting>
              <targetparameter>[scriptid=customscript_extend_files_wfa_upd_attach.custscript_extend_file_ref_field_id]</targetparameter>
