<?xml version="1.0"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
  <head>
    <style>
      * { font-family: Helvetica, Arial, sans-serif; }
      body { font-size: 10pt; color: #222222; }
      table { width: 100%; border-collapse: collapse; }
      td { padding: 4pt 6pt; vertical-align: top; }

      .header-table td { padding: 0; }
      .company-name { font-size: 14pt; font-weight: bold; color: #222222; }
      .company-address { font-size: 8.5pt; color: #666666; line-height: 1.4; }
      .doc-title { font-size: 22pt; font-weight: bold; color: #2c3e50; text-align: right; }
      .doc-subtitle { font-size: 9pt; color: #888888; text-align: right; }

      .divider { border-bottom: 2pt solid #2c3e50; margin-top: 8pt; margin-bottom: 12pt; }

      .field-label { font-size: 8pt; font-weight: bold; color: #888888; text-transform: uppercase; }
      .field-value { font-size: 10pt; color: #222222; }

      .section-title { font-size: 10.5pt; font-weight: bold; color: #2c3e50; padding-top: 10pt; padding-bottom: 4pt; border-bottom: 1pt solid #dddddd; }
      .memo-box { font-size: 9.5pt; color: #333333; padding-top: 6pt; padding-bottom: 6pt; line-height: 1.4; }

      .po-table th { font-size: 8pt; font-weight: bold; text-transform: uppercase; color: #666666; background-color: #f2f2f2; padding: 6pt; text-align: left; border-bottom: 1pt solid #dddddd; }
      .po-table td { font-size: 9.5pt; padding: 6pt; border-bottom: 0.5pt solid #eeeeee; }
      .po-count { font-size: 8.5pt; color: #888888; padding-top: 4pt; }
    </style>
  </head>
  <body size="Letter" padding="0.5in 0.6in">
    
    <#assign poRawText = "">
    <#if record.custrecord_po_number?is_sequence>
      <#list record.custrecord_po_number as poItem>
        <#assign poRawText = poRawText + (poItem.text!poItem?string) + " ">
      </#list>
    <#elseif record.custrecord_po_number?has_content>
      <#assign poRawText = record.custrecord_po_number?string>
    </#if>
    <#assign poRawText = poRawText?trim>

    <#assign relatedPOs = []>
    <#if poRawText?has_content>
      <#list poRawText?split("(?=Purchase Order #)", "r") as poChunk>
        <#if poChunk?trim?has_content>
          <#assign relatedPOs = relatedPOs + [ poChunk?trim ]>
        </#if>
      </#list>
    </#if>

    <!-- ===================== PO DETAILS LOOKUP ===================== -->
    <!-- poDetails is attached separately by the server script (see
         po_summary_render.js -> renderer.addCustomDataSource), since a
         List/Record field like custrecord_po_number only ever exposes
         display text/id - never amount, memo, or status. Those live on
         the Purchase Order transaction itself and have to be fetched via
         search in the script, then handed to this template as its own
         data source. Build a lookup keyed by PO number (tranid) so we can
         match it against the parsed relatedPOs labels above. -->
    <#assign poDetailsByTranId = {}>
    <#if poDetails?? && poDetails?is_sequence>
      <#list poDetails as pd>
        <#assign poDetailsByTranId = poDetailsByTranId + { pd.tranid?string: pd }>
      </#list>
    </#if>

    <#assign poCount = 0>

<#assign poList = record.custrecord_po_number?string?split("#")>


    <table class="header-table">
      <tr>
        <td style="width: 60%;" rowspan = "6">
          <#if companyInformation.logoUrl?has_content>
            <img src="${companyInformation.logoUrl}" style="height: 40pt; width: 70pt; margin-bottom: 6pt;" />
          </#if>
          <b>${companyInformation.legalname}</b><br/>
          ${companyInformation.addressText}
        </td>
        <td colspan = "2" font-size = "17pt" align = "center"><b>Group Summary</b></td>
      </tr>
      <tr>
        <td><b>Vendor</b></td>
        <td>${record.custrecord_vendor.altname}</td>
      </tr>
      <tr>
        <td><b>Date</b></td>
        <td>${.now?string("MM/dd/yyyy")}</td>
      </tr>
      <tr>
        <td><b>Version</b></td>
        <td>v${record.custrecord_revision_number}</td>
      </tr>
      <tr>
        <td><b>Memo</b></td>
        <td>${record.custrecord_master_memo}</td>
      </tr>
      <tr>
        <td><b>No. of POs</b></td>
        <td>
  ${poList?size?number - 1}
</td>
      </tr>
    </table>

    <!-- ===================== HEADER DETAILS GRID ===================== -->
    <!-- IMPORTANT: no colspan anywhere in this table - this engine appears
         to silently drop an entire table (not just the offending row) if
         colspan is used, which is what caused this whole section to
         disappear last time. Every row uses the same 4 equal columns;
         empty cells are left blank rather than spanned. rowspan is fine
         (used safely elsewhere) - it's specifically colspan to avoid. -->
    <table>
      <tr>
        <td style="width: 25%;">
          <span class="field-label">Email Status</span><br/>
          <span class="field-value">${record.custrecord_email_status}</span>
        </td>
        <td style="width: 25%;">
          <span class="field-label">Revision</span><br/>
          <span class="field-value">${record.custrecord_revision_number}</span>
        </td>
        <td style="width: 25%;">
          <span class="field-label">Purchase Orders</span><br/>
          <span class="field-value">${relatedPOs?size}</span>
        </td>
      </tr>
    </table>

    <!-- ===================== MASTER MEMO ===================== -->
    <#if record.custrecord_master_memo?has_content>
      <div class="section-title">Master Memo</div>
      <div class="memo-box">${record.custrecord_master_memo}</div>
    </#if>

    <!-- ===================== EMAIL BODY ===================== -->
    <!-- Rich Text field - already comes through as valid escaped HTML with
         real <br/> line breaks from the Suitelet, so render it directly
         rather than running it through  again (which would
         double-escape it and break the <br/> tags). -->
    <#if record.custrecord_email_body?has_content>
      <div class="section-title">Email Body</div>
      <div class="memo-box">${record.custrecord_email_body}</div>
    </#if>

    <!-- ===================== RELATED PURCHASE ORDERS ===================== -->
    <div class="section-title">Related Purchase Orders</div>
    <#if relatedPOs?has_content>
      <table class="po-table">
        <thead>
          <tr>
            <th style="width: 6%;">#</th>
            <th style="width: 20%;">PO Number</th>
            <th style="width: 16%;">Status</th>
            <th style="width: 16%;">Amount</th>
            <th>Memo</th>
          </tr>
        </thead>
        <tbody>
          <#assign totalAmount = 0>
          <#list relatedPOs as po>
            <!-- po is the raw label, e.g. "Purchase Order #PO400" - strip
                 the prefix to get just the tranid ("PO400") for lookup -->
            <#assign poTranId = po?replace("Purchase Order #", "")?trim>
            <#assign detail = poDetailsByTranId[poTranId]!{}>
            <#if detail.amount?? && detail.amount?is_number>
              <#assign totalAmount = totalAmount + detail.amount>
            <#elseif detail.amount?? && detail.amount?has_content>
              <#assign totalAmount = totalAmount + detail.amount?number>
            </#if>
            <tr>
              <td>${po_index + 1}</td>
              <td>${poTranId}</td>
              <td>${(detail.status)!""}</td>
              <td><#if detail.amount??>${detail.amount}</#if></td>
              <td>${(detail.memo)!""}</td>
            </tr>
          </#list>
        </tbody>
      </table>
      <div class="po-count">
        ${relatedPOs?size} Purchase Order<#if relatedPOs?size gt 1>s</#if> included in this send.
        <#if totalAmount gt 0> &mdash; Total: ${totalAmount?string(",##0.00")}</#if>
      </div>
    <#else>
      <div class="memo-box">No related Purchase Orders found.</div>
    </#if>

  </body>
</pdf>